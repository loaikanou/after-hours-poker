# Copy to .env.local, or just run `npm run dev`: the Convex CLI creates
# .env.local and fills these in for your own dev deployment.

# Which deployment `npx convex dev` targets (e.g. dev:happy-animal-123).
CONVEX_DEPLOYMENT=

# The deployment URL the app connects to. Inlined into the bundle at build time.
VITE_CONVEX_URL=https://<your-deployment>.convex.cloud

# HTTP-actions endpoint. Written by the CLI; not used by the app.
VITE_CONVEX_SITE_URL=https://<your-deployment>.convex.site

# Optional, build only: public URL and path of the site (see README → Environment variables).
# SITE_URL=https://example.com
# BASE_PATH=/

# Never put CONVEX_DEPLOY_KEY in a file: store it as a CI / Vercel secret.
